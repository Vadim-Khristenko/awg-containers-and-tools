#!/bin/bash
# The AllowedIPs of a full tunnel minus the given CIDRs.
#
#   awg-exclude 192.168.0.0/16,10.0.0.0/8 fd00::/8
#
# WireGuard has no "exclude" key; a client routes what AllowedIPs lists. So a
# full tunnel that keeps a LAN off the tunnel is the complement: 0.0.0.0/0 and
# ::/0 cut into the fewest prefixes that cover everything else. Prints one
# comma-separated line, IPv4 first, each family in address order; a family
# nothing is excluded from stays one default route. Host bits in a CIDR are
# dropped, as the daemon drops them.
#
# awg-tool computes the same in Rust (crates/awg-core/src/exclude.rs), and
# utiltest.sh holds both to the same vectors. Addresses are handled as strings
# of 0 and 1: bash arithmetic stops at 64 bits and IPv6 needs 128.
set -euo pipefail

die() { printf '!! %s\n' "$*" >&2; exit 2; }

# A dotted quad as 32 bits.
v4_bits() {
    local IFS=. o i out=""
    local -a parts
    read -ra parts <<< "$1"
    [ "${#parts[@]}" = 4 ] || return 1
    for o in "${parts[@]}"; do
        [[ "$o" =~ ^[0-9]{1,3}$ ]] && [ "$((10#$o))" -le 255 ] || return 1
        o=$((10#$o))
        for ((i = 7; i >= 0; i--)); do out+=$(((o >> i) & 1)); done
    done
    printf '%s' "$out"
}

# An IPv6 address as 128 bits. "::" stands for the zero groups it replaces.
v6_bits() {
    local a=$1 head tail g i n out=""
    local -a hs=() ts=() groups=()
    case "$a" in *::*::*) return 1 ;; esac
    if [[ "$a" == *::* ]]; then
        head=${a%%::*} tail=${a#*::}
        [ -n "$head" ] && IFS=: read -ra hs <<< "$head"
        [ -n "$tail" ] && IFS=: read -ra ts <<< "$tail"
        n=$((8 - ${#hs[@]} - ${#ts[@]}))
        [ "$n" -ge 1 ] || return 1
        groups=(${hs[@]+"${hs[@]}"})
        for ((i = 0; i < n; i++)); do groups+=(0); done
        groups+=(${ts[@]+"${ts[@]}"})
    else
        IFS=: read -ra groups <<< "$a"
    fi
    [ "${#groups[@]}" = 8 ] || return 1
    for g in "${groups[@]}"; do
        [[ "$g" =~ ^[0-9a-fA-F]{1,4}$ ]] || return 1
        g=$((16#$g))
        for ((i = 15; i >= 0; i--)); do out+=$(((g >> i) & 1)); done
    done
    printf '%s' "$out"
}

# 32 bits back to a dotted quad, in REPLY: a subshell per prefix is slow.
bits_v4() {
    local b=$1 i
    REPLY=""
    for ((i = 0; i < 32; i += 8)); do REPLY+="${REPLY:+.}$((2#${b:i:8}))"; done
}

# 128 bits back to IPv6 text, in REPLY, the longest run of two or more zero
# groups (the first, on a tie) written as "::", the way RFC 5952 and Rust
# print it.
bits_v6() {
    local b=$1 i run=0 start=-1 best=0 bstart=-1 left="" right=""
    local -a g=()
    for ((i = 0; i < 8; i++)); do printf -v 'g[i]' '%x' "$((2#${b:i*16:16}))"; done
    for ((i = 0; i < 8; i++)); do
        if [ "${g[i]}" = 0 ]; then
            [ "$run" = 0 ] && start=$i
            run=$((run + 1))
            if [ "$run" -gt "$best" ]; then best=$run bstart=$start; fi
        else
            run=0
        fi
    done
    if [ "$best" -lt 2 ]; then
        bstart=8 best=0
    fi
    for ((i = 0; i < bstart && i < 8; i++)); do left+="${left:+:}${g[i]}"; done
    for ((i = bstart + best; i < 8; i++)); do right+="${right:+:}${g[i]}"; done
    if [ "$bstart" = 8 ]; then REPLY=$left; else REPLY="$left::$right"; fi
}

V4=() V6=() OUT=()

# Emit prefix $1 whole if no exclusion touches it, nothing if one covers it,
# and otherwise each half in turn, lower half first.
walk() {
    local p=$1 width=$2 e inside=0
    shift 2
    for e in "$@"; do
        if [ "${#e}" -le "${#p}" ] && [ "${p:0:${#e}}" = "$e" ]; then return; fi
        if [ "${#e}" -gt "${#p}" ] && [ "${e:0:${#p}}" = "$p" ]; then inside=1; fi
    done
    if [ "$inside" = 0 ]; then
        local full=$p
        while [ "${#full}" -lt "$width" ]; do full+=0; done
        if [ "$width" = 32 ]; then bits_v4 "$full"; else bits_v6 "$full"; fi
        OUT+=("$REPLY/${#p}")
        return
    fi
    walk "${p}0" "$width" "$@"
    walk "${p}1" "$width" "$@"
}

for arg in "$@"; do
    IFS=', ' read -ra cidrs <<< "$arg"
    for raw in ${cidrs[@]+"${cidrs[@]}"}; do
        [ -n "$raw" ] || continue
        ip=${raw%%/*}
        if [[ "$ip" == *:* ]]; then width=128; bits=$(v6_bits "$ip") || die "\"$raw\" is not an IPv4 or IPv6 CIDR"
        else width=32; bits=$(v4_bits "$ip") || die "\"$raw\" is not an IPv4 or IPv6 CIDR"
        fi
        len=$width
        if [[ "$raw" == */* ]]; then
            len=${raw#*/}
            [[ "$len" =~ ^[0-9]{1,3}$ ]] && [ "$((10#$len))" -le "$width" ] \
                || die "\"$raw\" is not an IPv4 or IPv6 CIDR"
            len=$((10#$len))
        fi
        if [ "$width" = 32 ]; then V4+=("${bits:0:len}"); else V6+=("${bits:0:len}"); fi
    done
done

walk "" 32 ${V4[@]+"${V4[@]}"}
walk "" 128 ${V6[@]+"${V6[@]}"}
(IFS=,; printf '%s\n' "${OUT[*]}")
