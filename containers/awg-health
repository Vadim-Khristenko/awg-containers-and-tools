#!/bin/sh
# The container health check: the interface is up and the daemon answers.
#
# Deliberately not checked: handshakes and transfer counters. A node with no
# peers yet is healthy, and restarting a good node into the same silence fixes
# nothing.
set -eu

IFACE="${AWG_IFACE:-awg0}"

ip link show dev "$IFACE" >/dev/null 2>&1 || {
    echo "unhealthy: interface $IFACE does not exist" >&2
    exit 1
}

# `get=1` answers with the device dump and puts `errno=0` on the *last* line.
# Reading only the first line means reading `private_key=…`, which made every
# healthy node report unhealthy — and its key material look like the problem.
out=$(awg-uapi get "$IFACE" 2>&1) || true

if printf '%s\n' "$out" | grep -q '^errno=0$'; then
    exit 0
fi

last=$(printf '%s\n' "$out" | tail -n 1)
echo "unhealthy: UAPI said ${last:-nothing}" >&2
exit 1
