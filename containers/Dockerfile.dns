# The tunnel's resolver — unbound on a dedicated docker network at a fixed
# address, which is the shape upstream AmneziaVPN uses.
#
# The anti-leak property is not cryptographic. 172.29.172.254 is an RFC1918
# address on a bridge that only the AWG container joins, it is never published
# to the host, and docker's own DOCKER-ISOLATION rules drop forwarding between
# bridges. So a client whose `DNS = 172.29.172.254` can only reach it through
# the tunnel: if the tunnel is down or the query escapes it, the query does not
# fall back to the local network's resolver, it simply gets no answer. A leak
# announces itself instead of hiding. See containers/dnstest.sh for the proof
# in both directions.
#
# unbound resolves from the root zone itself rather than forwarding to a public
# resolver: forwarding would move the leak rather than close it — the whole
# query stream would just be legible to whoever runs 1.1.1.1 instead.
FROM alpine:3.24
ARG BUILD_DATE=1970-01-01T00:00:00Z
ARG AWG_DNS_ADDRESS=172.29.172.254
# See the same argument in containers/Dockerfile: it lets the release pipeline
# tell "identical image, new tag" from "actually rebuilt".
ARG INPUTS_DIGEST=
LABEL org.opencontainers.image.title="amnezia-wg-dns — tunnel-only resolver (unofficial)" \
      org.opencontainers.image.description="unbound recursive resolver for the AmneziaWG containers, reachable only from inside the tunnel. UNOFFICIAL community build — not affiliated with, endorsed by or supported by AmneziaVPN." \
      org.opencontainers.image.authors="Vadim Khristenko (VAI_PROG)" \
      org.opencontainers.image.vendor="Vadim Khristenko (VAI_PROG)" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.source="https://github.com/Vadim-Khristenko/awg-containers-and-tools" \
      org.opencontainers.image.url="https://github.com/Vadim-Khristenko/awg-containers-and-tools" \
      org.opencontainers.image.documentation="https://architect.vai-rice.space" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.base.name="docker.io/library/alpine:3.24" \
      space.vai-rice.awg.dns-address="${AWG_DNS_ADDRESS}" \
      space.vai-rice.awg.inputs="${INPUTS_DIGEST}"

# unbound only. No dig, no bind-tools, no shell utilities beyond busybox: this
# image exists to answer port 53 and nothing else, and every extra package is
# another thing to patch on a host that is meant to be forgettable. libcap is
# the one deliberate extra: it lets the container run as an unprivileged user
# and still bind port 53, via a file capability on the binary rather than a
# root process.
RUN apk add --no-cache unbound libcap \
 && rm -rf /var/cache/apk/* /usr/share/man \
 && mkdir -p /var/log/unbound /etc/unbound/blacklist.d \
 && chown unbound:unbound /var/log/unbound \
 && setcap cap_net_bind_service=+ep /usr/sbin/unbound

COPY unbound.conf /etc/unbound/unbound.conf
COPY entrypoint-dns.sh /usr/local/bin/entrypoint-dns.sh
RUN chmod +x /usr/local/bin/entrypoint-dns.sh

# The tunnel containers stay root by necessity — building an interface and
# writing NAT rules need CAP_NET_ADMIN for as long as the node lives. This one
# has no such excuse: unbound drops to its own user anyway, and running the
# whole container as that user from the start means the resolver is one less
# thing on the host that can touch anything outside its own files.
USER unbound

EXPOSE 53/udp 53/tcp
# The health check asks the resolver for a name answered from its own config —
# no upstream involved. A resolver that is up while the uplink is down is
# healthy, and restarting it would not bring the internet back.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD nslookup health.awg.internal 127.0.0.1 >/dev/null 2>&1 || exit 1
# -d keeps it in the foreground so docker sees the real process; -p means "do
# not fork a pidfile writer", which an unprivileged read-only container cannot
# write anyway.
ENTRYPOINT ["/usr/local/bin/entrypoint-dns.sh"]
