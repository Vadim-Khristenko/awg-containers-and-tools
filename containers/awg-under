#!/bin/sh
# "Am I under the VPN?" asked from inside the node, the way amiunder.vpn asks
# it in a browser, and answered from more than one side:
#
#   dns     the tunnel's resolver answers the page's name (only it can: .vpn
#           is not a real TLD)
#   system  whether the node's own resolver answers it too, which says where
#           this node's queries go
#   page    the page answers (it is reachable only through the tunnel) and
#           which address it saw
#   ipv6    whether an IPv6 default route leaves outside the tunnel
#
#   awg-under [--json] [url|host]   default amiunder.vpn
#   AWG_UNDER_EXPECT=<addr>         the address the far end should report
#   AWG_CLIENT_DNS=<addr>           the tunnel resolver (172.29.172.254)
#
# The verdict is the page: exit 0 when it answered, 1 when it did not. The
# other lines explain it, they do not overrule it.
set -eu

IFACE="${AWG_IFACE:-awg0}"
RESOLVER="${AWG_CLIENT_DNS:-172.29.172.254}"
JSON=0
if [ "${1:-}" = --json ]; then JSON=1; shift; fi
target="${1:-${AWG_UNDER_URL:-amiunder.vpn}}"
case "$target" in
    http://*|https://*) URL="$target" ;;
    */cgi-bin/*)        URL="http://$target" ;;
    *)                  URL="http://$target/cgi-bin/whoami" ;;
esac
hostport=${URL#*://}; hostport=${hostport%%/*}
host=${hostport%%:*}
port=80
case "$hostport" in *:*) port=${hostport##*:} ;; esac

# The first address in a busybox nslookup answer, after the server's own.
# nslookup's own timeout rather than timeout(1): killing it makes the shell
# report the signal on the terminal.
answer() {
    nslookup -timeout="${AWG_UNDER_DNS_TIMEOUT:-3}" -retry=1 "$1" ${2:+"$2"} 2>/dev/null \
        | awk '/^Name:/ { named = 1 } named && /^Address/ { sub(/^Address[^:]*: */, ""); print; exit }'
}
is_ip() { printf '%s' "$1" | grep -Eq '^[0-9.]+$|:'; }

# This node's own address on the tunnel: what the far end reports when
# nothing translates the path in between.
mine=$(ip -o -4 addr show dev "$IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1) || true
want="${AWG_UNDER_EXPECT:-$mine}"

dns_addr= sys_addr=
if ! is_ip "$host"; then
    dns_addr=$(answer "$host" "$RESOLVER") || true
    sys_addr=$(answer "$host") || true
fi

v6_out=$(ip -6 route show default 2>/dev/null | awk 'NR==1 { for (i = 1; i < NF; i++) if ($i == "dev") print $(i + 1) }') || true

seen=
if [ -n "$mine" ]; then
    # Ask for the page at the address the tunnel resolver gave, so a node whose
    # own resolver does not know .vpn still reaches it the way a client would.
    if [ -n "$dns_addr" ] && [ -z "$sys_addr" ]; then
        resolve="--resolve $host:$port:$dns_addr"
    else
        resolve=
    fi
    # shellcheck disable=SC2086
    seen=$(curl -fsS --max-time "${AWG_UNDER_TIMEOUT:-8}" $resolve "$URL" 2>/dev/null | head -1 | tr -d '[:space:]') || true
fi

if [ "$JSON" = 1 ]; then
    q() { if [ -n "$1" ]; then printf '"%s"' "$1"; else printf 'null'; fi; }
    printf '{"under":%s,"url":"%s","interface":"%s","address":%s,"seen":%s,' \
        "$([ -n "$seen" ] && echo true || echo false)" "$URL" "$IFACE" "$(q "$mine")" "$(q "$seen")"
    printf '"tunnel_resolver":"%s","tunnel_answer":%s,"system_answer":%s,"ipv6_default_dev":%s}\n' \
        "$RESOLVER" "$(q "$dns_addr")" "$(q "$sys_addr")" "$(q "$v6_out")"
    [ -n "$seen" ]
    exit
fi

if [ -z "$mine" ]; then
    echo "not under the VPN: $IFACE has no IPv4 address, there is no tunnel here" >&2
    exit 1
fi
if [ -z "$seen" ]; then
    echo "not under the VPN: nothing answered at $URL" >&2
    status=1
elif [ "$seen" = "$want" ]; then
    echo "under the VPN: $URL answered and sees $seen, which is this node on $IFACE"
    status=0
else
    # Reached it, but as somebody else: a NAT in the path, or a page that is
    # not the one this check is for. Still an answer from inside the tunnel.
    echo "under the VPN: $URL answered, seeing $seen (this node is $mine on $IFACE, the path is translated)"
    status=0
fi

if ! is_ip "$host"; then
    if [ -n "$dns_addr" ]; then
        echo "  dns     $host is $dns_addr at the tunnel resolver $RESOLVER"
    else
        echo "  dns     the tunnel resolver $RESOLVER did not answer for $host"
    fi
    if [ -n "$sys_addr" ]; then
        echo "  system  this node's own resolver answers $host too: its queries go through the tunnel"
    else
        echo "  system  this node's own resolver does not know $host: its queries do not reach the tunnel resolver"
    fi
fi
case "$v6_out" in
    "")      echo "  ipv6    no IPv6 default route" ;;
    "$IFACE") echo "  ipv6    the IPv6 default route is the tunnel" ;;
    *)       echo "  ipv6    IPv6 default route via $v6_out: IPv6 traffic leaves outside the tunnel" ;;
esac
exit "$status"
